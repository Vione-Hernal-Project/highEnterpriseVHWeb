# Must match the live site domain you expect Supabase auth emails to return to.
# Also add this domain, plus the matching www/apex variant when both can resolve,
# to Supabase Auth Site URL / Redirect URLs.
PUBLIC_SITE_URL=https://your-production-domain.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional shared production rate limiting. When set, auth/order/payment limits
# use Upstash Redis instead of the in-memory single-instance fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use one complete Ethereum Mainnet RPC URL only. Do not paste a provider URL inside itself.
ETHEREUM_MAINNET_RPC_URL=https://your-ethereum-mainnet-rpc-url
# Mobile-only MetaMask Connect uses a browser-safe mainnet RPC URL.
NEXT_PUBLIC_METAMASK_CONNECT_RPC_URL=https://your-public-ethereum-mainnet-rpc-url
COINGECKO_SIMPLE_PRICE_ENDPOINT=https://api.coingecko.com/api/v3/simple/price
COINGECKO_DEMO_API_KEY=
# Public Binance market ticker endpoint. No API key is required for this price check.
BINANCE_TICKER_PRICE_ENDPOINT=https://api.binance.com/api/v3/ticker/price
CRYPTO_PRICE_DIFF_TOLERANCE_PERCENT=2
CRYPTO_SLIPPAGE_BUFFER_PERCENT=1.5
CRYPTO_QUOTE_TTL_SECONDS=60
NEXT_PUBLIC_MERCHANT_EVM_WALLET=0xYourMerchantWalletAddress
NEXT_PUBLIC_MERCHANT_SOLANA_WALLET=YourSolanaMainnetMerchantWallet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# TODO(mainnet-launch): paste the deployed Ethereum Mainnet VHL token contract address.
NEXT_PUBLIC_VHL_TOKEN_ADDRESS=
NEXT_PUBLIC_USDC_EVM_CONTRACT=
NEXT_PUBLIC_USDT_EVM_CONTRACT=
NEXT_PUBLIC_USDC_SOLANA_MINT=
NEXT_PUBLIC_USDT_SOLANA_MINT=
# Set this to the email of the store-owner account if you want the saved dashboard wallet address
# to become the active checkout recipient.
STORE_OWNER_EMAILS=owner@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=Vione Hernal <no-reply@example.com>
STORE_NOTIFICATION_EMAIL=orders@example.com
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Browser-safe Mapbox public token for interactive map tiles.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Optional server-side Mapbox token for geocoding. Falls back to NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN when empty.
MAPBOX_ACCESS_TOKEN=
